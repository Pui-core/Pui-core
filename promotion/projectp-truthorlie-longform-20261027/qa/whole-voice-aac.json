      "wholePhraseRetained": true
    },
    {
      "id": "r2think",
      "text": "透明人間の想像から、食事や休日まで。内容の違う答えが並びました。五つを見比べて、どの答えに一票を置くか決めてください。",
      "at": 195.5,
      "declaredEnd": 206.5,
      "wavSeconds": 9.386666666666667,
      "wholePcmMaxError": 1.162290573786251e-7,
      "firstVoicedSecond": 0.07741666666666666,
