      "tailCorrelation": 0.9999961665009739,
      "sourceWaveSha256": "6931f882ac84552b5b680771e145be9b29568f70dce763ae11fea3f45a0f9e32",
      "wholePhraseRetained": true
    },
    {
      "id": "r3reveal",
      "text": "票は五番。結果は、正解者なしでした。嘘は三番の、海辺の小さな家。出題役のエーエーに一点が入り、一対二になりました。",
      "at": 295.5,
      "declaredEnd": 308,
      "wavSeconds": 10.453333333333333,
      "wholePcmMaxError": 1.1920928955078125e-7,
      "firstVoicedSecond": 0.0886875,
      "lastVoicedSecond": 10.321020833333334,
      "lagSamples": 0,
      "wholeCorrelation": 0.9998652724042895,
      "headCorrelation": 0.999889870511379,
      "tailCorrelation": 0.9999720486213474,
      "sourceWaveSha256": "6173cbede14bf10869ac256040b949e23544b4d7cf4ab1eb028192e99357f68f",
      "wholePhraseRetained": true
    },
    {
      "id": "r3bridge",
      "text": "次が、最後のラウンドです。",
      "at": 308,
      "declaredEnd": 312,
      "wavSeconds": 2.144,
      "wholePcmMaxError": 1.1920928955078125e-7,
      "firstVoicedSecond": 0.0769375,
      "lastVoicedSecond": 2.0073958333333333,
      "lagSamples": 0,
      "wholeCorrelation": 0.9998737082897157,
      "headCorrelation": 0.9989703826081622,
      "tailCorrelation": 0.9994007804864082,
      "sourceWaveSha256": "991e7a3db7274ead1ce82fe3b4e2ad44d5e296b58ed5b66b6919f7920286786c",
      "wholePhraseRetained": true
    },
    {
      "id": "r4intro",
      "text": "四ラウンド目は、操作例ビービーの出題です。エーエーは一点、ビービーは二点。今回当てれば同点です。",
      "at": 312,
      "declaredEnd": 321,
      "wavSeconds": 7.946666666666666,
      "wholePcmMaxError": 1.2516975400611585e-7,
      "firstVoicedSecond": 0.07302083333333333,
      "lastVoicedSecond": 7.7643125,
      "lagSamples": 0,
      "wholeCorrelation": 0.999867976616793,
      "headCorrelation": 0.9998616681957152,
      "tailCorrelation": 0.9996150341065941,
      "sourceWaveSha256": "a57e49052c4706728ecc6adbba4425603e5a9bca13e1f4ca18b4817625ee1e76",
      "wholePhraseRetained": true
    },
    {
      "id": "r4q1",
      "text": "一つ目。魔法が一つ使えるなら欲しい能力。忘れ物をすぐ見つける力。",
      "at": 321,
      "declaredEnd": 329.5,
      "wavSeconds": 5.44,
      "wholePcmMaxError": 1.162290572676028e-7,
      "firstVoicedSecond": 0.07333333333333333,
      "lastVoicedSecond": 5.288125,
      "lagSamples": 0,
      "wholeCorrelation": 0.9999178629845382,
      "headCorrelation": 0.9999442226775077,
      "tailCorrelation": 0.9999366794608164,
      "sourceWaveSha256": "2f60e63cbc21f715c430c0dfc684cbcbe67a818749a5fe236c574960277f1d1d",
      "wholePhraseRetained": true
    },
    {
      "id": "r4q2",
      "text": "二つ目。冷蔵庫に必ず入っているもの。無糖のヨーグルト。",
      "at": 329.5,
      "declaredEnd": 338,
      "wavSeconds": 4.298666666666667,
      "wholePcmMaxError": 1.221895218339597e-7,
      "firstVoicedSecond": 0.0734375,
      "lastVoicedSecond": 4.1511875,
      "lagSamples": 0,
      "wholeCorrelation": 0.99982438831821,
      "headCorrelation": 0.9998836010700467,
      "tailCorrelation": 0.9999898624163637,
      "sourceWaveSha256": "5a6643e10c1726bae6912c9e02323f29e291cf9c45a70ca94b2d9112cf061e09",
      "wholePhraseRetained": true
    },
    {
      "id": "r4q3",
      "text": "三つ目。子どもの頃に本気で怖がっていた場所。夜の学校の階段。",
      "at": 338,
      "declaredEnd": 346.5,
      "wavSeconds": 5.013333333333334,
      "wholePcmMaxError": 1.341104507446289e-7,
      "firstVoicedSecond": 0.06264583333333333,
      "lastVoicedSecond": 4.84575,
      "lagSamples": 0,
      "wholeCorrelation": 0.9997177207882275,
      "headCorrelation": 0.9956197263836652,
      "tailCorrelation": 0.9999531699139376,
      "sourceWaveSha256": "a6fe4d9e371462f0e12444f893c947987b1f912a81b1976ad2d73d41f65c2047",
      "wholePhraseRetained": true
    },
    {
      "id": "r4q4",
      "text": "四つ目。旅行の荷物に必ず入れるもの。小さなノート。",
      "at": 346.5,
      "declaredEnd": 355,
      "wavSeconds": 4.181333333333333,
      "wholePcmMaxError": 1.2516975400611585e-7,
      "firstVoicedSecond": 0.07054166666666667,
      "lastVoicedSecond": 4.0675,
      "lagSamples": 0,
      "wholeCorrelation": 0.999892406819925,
      "headCorrelation": 0.9999302384100921,
      "tailCorrelation": 0.9999869943994697,
      "sourceWaveSha256": "931dcc9aad2cedf9211e3a449ca2d1c203dad6f86036ac41949839ecdfe438e3",
      "wholePhraseRetained": true
    },
    {
      "id": "r4q5",
      "text": "五つ目。人生でまだ諦めていないこと。自分の絵本を作ること。",
      "at": 355,
      "declaredEnd": 363.5,
      "wavSeconds": 4.714666666666667,
      "wholePcmMaxError": 1.341104507446289e-7,
      "firstVoicedSecond": 0.06116666666666667,
      "lastVoicedSecond": 4.5566458333333335,
      "lagSamples": 0,
      "wholeCorrelation": 0.999832477509607,
      "headCorrelation": 0.9997570441678889,
      "tailCorrelation": 0.9999824637102517,
      "sourceWaveSha256": "ebfccc46b444753e2289316e4143a3e15ddc89f0a68cc7ff53be0b91e7756dd2",
      "wholePhraseRetained": true
    },
    {
      "id": "r4think",
      "text": "最後の五つです。何番に票を入れるか決めてみてください。これまでと同じ見方で選びますか。それとも、別の答えに注目しますか。",
      "at": 363.5,
      "declaredEnd": 374.5,
      "wavSeconds": 9.034666666666666,
      "wholePcmMaxError": 1.3709068302780736e-7,
      "firstVoicedSecond": 0.07814583333333333,
      "lastVoicedSecond": 8.883729166666667,
      "lagSamples": 0,
      "wholeCorrelation": 0.9998429831545952,
      "headCorrelation": 0.9998394691173916,
      "tailCorrelation": 0.9999862699771392,
      "sourceWaveSha256": "f6d662fed28de5902d68f0b62cb1d9b7d275b3f141e7cecc04ac338cd52ef34f",
      "wholePhraseRetained": true
    },
    {
      "id": "r4reveal",
      "text": "二番を選択。結果は投票的中。嘘は、無糖のヨーグルトでした。エーエーに一点が入り、最終スコアは二対二です。",
      "at": 379.5,
      "declaredEnd": 392,
      "wavSeconds": 9.237333333333334,
      "wholePcmMaxError": 1.460313796552981e-7,
      "firstVoicedSecond": 0.0654375,
      "lastVoicedSecond": 9.05475,
      "lagSamples": 0,
      "wholeCorrelation": 0.9998945254288116,
      "headCorrelation": 0.9998596846444722,
      "tailCorrelation": 0.999964416258243,
      "sourceWaveSha256": "aa2aac626d7e3e6eb77b5bba66467ff6a88217b7f928e3153c7c8dfd593dc177",
      "wholePhraseRetained": true
    },
    {
      "id": "r4bridge",
      "text": "四ラウンドを、終えました。",
      "at": 392,
      "declaredEnd": 396,
      "wavSeconds": 2.005333333333333,
      "wholePcmMaxError": 1.4305114759416426e-7,
      "firstVoicedSecond": 0.07110416666666666,
      "lastVoicedSecond": 1.8579791666666667,
      "lagSamples": 0,
      "wholeCorrelation": 0.9999714787679977,
      "headCorrelation": 0.9999911311404196,
      "tailCorrelation": 0.9999089777267345,
      "sourceWaveSha256": "72e10fa599cfe9dc0d6857701009fd0551772b9a7d662cbe7d83bb0ec185a050",
      "wholePhraseRetained": true
    },
    {
      "id": "normalfinal",
      "text": "実際の最終結果は、引き分けです。正解する側だけでなく、見破られなかった出題側にも点が入りました。四回の投票と得点が、最後の二対二につながっています。ここからは、別の設定をもう一つ見てみます。",
      "at": 396,
      "declaredEnd": 416,
      "wavSeconds": 15.168,
      "wholePcmMaxError": 1.281499862892943e-7,
      "firstVoicedSecond": 0.07666666666666666,
      "lastVoicedSecond": 14.994020833333334,
      "lagSamples": 0,
      "wholeCorrelation": 0.9999185710946111,
      "headCorrelation": 0.9998623184596073,
      "tailCorrelation": 0.9995650697646588,
      "sourceWaveSha256": "c4677117aac3588d1370f1a80de319517c98c443f506e9dfd6c63b6997bbac8e",
      "wholePhraseRetained": true
    },
    {
      "id": "t1intro",
      "text": "次は別試合。三ラウンド、嘘をつかない宣言を使える設定で試します。",
      "at": 416,
      "declaredEnd": 425,
      "wavSeconds": 5.386666666666667,
      "wholePcmMaxError": 1.5497207650483347e-7,
      "firstVoicedSecond": 0.07704166666666666,
      "lastVoicedSecond": 5.2108125,
      "lagSamples": 0,
      "wholeCorrelation": 0.9998748454754195,
      "headCorrelation": 0.9995085784674665,
      "tailCorrelation": 0.9998730398113341,
      "sourceWaveSha256": "77ff8e52a734fa4a6a24a8c2f7750d89e69d2a796f35b7cdb16541b4088e175b",
      "wholePhraseRetained": true
    },
    {
      "id": "t1q1",
      "text": "一つ目。デートで行ってみたい場所。海の見える水族館。",
      "at": 425,
      "declaredEnd": 433.5,
      "wavSeconds": 4.16,
      "wholePcmMaxError": 1.281499862892943e-7,
      "firstVoicedSecond": 0.07627083333333333,
      "lastVoicedSecond": 3.9915625,
      "lagSamples": 0,
      "wholeCorrelation": 0.9998764423026144,
      "headCorrelation": 0.9996934137745832,
      "tailCorrelation": 0.9999894348743649,
      "sourceWaveSha256": "f28f96d06de2c62e1ad562240d235f89a2284d52c862850f4c73f482986a6f0b",
      "wholePhraseRetained": true
    },
    {
      "id": "t1q2",
      "text": "二つ目。明日から1年休みをもらえたらすること。各地の美術館を巡る。",
      "at": 433.5,
      "declaredEnd": 442,
      "wavSeconds": 5.312,
      "wholePcmMaxError": 1.341104507446289e-7,
      "firstVoicedSecond": 0.0734375,
      "lastVoicedSecond": 5.207520833333334,
      "lagSamples": 0,
      "wholeCorrelation": 0.9997835835012733,
      "headCorrelation": 0.9999627893259657,
      "tailCorrelation": 0.9999903523982472,
      "sourceWaveSha256": "2be9627ce6119c11a1baa77ccd2b9085680e9eee7ae0e5cd06eaf6849592ac7b",
      "wholePhraseRetained": true
    },
    {
      "id": "t1q3",
      "text": "三つ目。死ぬまでに行ってみたい場所。北欧の小さな町。",
      "at": 442,
      "declaredEnd": 450.5,
      "wavSeconds": 4.149333333333334,
      "wholePcmMaxError": 1.162290572676028e-7,
      "firstVoicedSecond": 0.06316666666666666,
      "lastVoicedSecond": 4.027354166666667,
      "lagSamples": 0,
      "wholeCorrelation": 0.9997688161006574,
      "headCorrelation": 0.9997681358602085,
      "tailCorrelation": 0.9999245770111167,
      "sourceWaveSha256": "18fb6f975ced1e6237d27dad534ed9bdd623e76cc52c49891fd81c071d5342ed",
      "wholePhraseRetained": true
    },
    {
      "id": "t1q4",
      "text": "四つ目。実家や家の独特なルール。玄関で靴をそろえる。",
      "at": 450.5,
      "declaredEnd": 459,
      "wavSeconds": 4.554666666666667,
      "wholePcmMaxError": 1.221895218339597e-7,
      "firstVoicedSecond": 0.07275,
      "lastVoicedSecond": 4.4425625,
      "lagSamples": 0,
      "wholeCorrelation": 0.999920755275704,
      "headCorrelation": 0.9999868724064027,
      "tailCorrelation": 0.9999925967716651,
      "sourceWaveSha256": "8492d07a50a3e02d4838f5262dc2fbdb95208428770a44023f2b4cffdd8abdf4",
      "wholePhraseRetained": true
    },
    {
      "id": "t1q5",
      "text": "五つ目。人には言いにくい小さな贅沢。夜に少し高いチョコ。",
      "at": 459,
      "declaredEnd": 467.5,
      "wavSeconds": 4.714666666666667,
      "wholePcmMaxError": 1.3113021846145045e-7,
      "firstVoicedSecond": 0.06116666666666667,
      "lastVoicedSecond": 4.546791666666667,
      "lagSamples": 0,
      "wholeCorrelation": 0.9998331568603114,
      "headCorrelation": 0.9997974038566254,
      "tailCorrelation": 0.9997652829480115,
      "sourceWaveSha256": "340b1bc089078cdb92687e706a8883729dd0c78addc31d76da4df1f685c1cfe5",
      "wholePhraseRetained": true
    },
    {
      "id": "t1think",
      "text": "この設定では、番号だけでなく、真実のみという投票先も選べます。五つを見比べて、嘘があるかどうかも考えてみてください。",
      "at": 467.5,
      "declaredEnd": 478.5,
      "wavSeconds": 9.024,
      "wholePcmMaxError": 1.2516975400611585e-7,
      "firstVoicedSecond": 0.07775,
      "lastVoicedSecond": 8.863083333333334,
      "lagSamples": 0,
      "wholeCorrelation": 0.999874950075421,
      "headCorrelation": 0.999960441892377,
      "tailCorrelation": 0.9999156840218238,
      "sourceWaveSha256": "0f41b349387adbe24860952d217419d2293af5d098a62e0d3fcb60eb5ba93f72",
      "wholePhraseRetained": true
    },
    {
      "id": "t1reveal",
      "text": "真実のみに投票し、的中。今回は嘘をつかない宣言で、五つとも真実という設定でした。ビービーに一点です。",
      "at": 483.5,
      "declaredEnd": 496,
      "wavSeconds": 8.725333333333333,
      "wholePcmMaxError": 1.162290572676028e-7,
      "firstVoicedSecond": 0.07541666666666667,
      "lastVoicedSecond": 8.5428125,
      "lagSamples": 0,
      "wholeCorrelation": 0.9998605451532913,
      "headCorrelation": 0.9998662621884122,
      "tailCorrelation": 0.9999777857250619,
      "sourceWaveSha256": "7fbca362dc43e90de847689b42a16c98c280de47db3100efbccf4422d7378655",
      "wholePhraseRetained": true
    },
    {
      "id": "t1bridge",
      "text": "次のラウンドへ進みます。",
      "at": 496,
      "declaredEnd": 500,
      "wavSeconds": 1.6853333333333333,
      "wholePcmMaxError": 1.341104507446289e-7,
      "firstVoicedSecond": 0.0766875,
      "lastVoicedSecond": 1.5156666666666667,
      "lagSamples": 0,
      "wholeCorrelation": 0.9998568239986501,
      "headCorrelation": 0.9993610958700051,
      "tailCorrelation": 0.9995216824363827,
      "sourceWaveSha256": "d3acdf5ba2a38caf784c8c93512d2ebc94570e397843f50b311b03916ede0f9c",
      "wholePhraseRetained": true
    },
    {
      "id": "t2intro",
      "text": "別試合の二ラウンド目。今度はビービーが出題します。設定が同じでも、答え方は選べます。",
      "at": 500,
      "declaredEnd": 509,
      "wavSeconds": 6.784,
      "wholePcmMaxError": 1.3113021857247276e-7,
      "firstVoicedSecond": 0.06,
      "lastVoicedSecond": 6.607833333333334,
      "lagSamples": 0,
      "wholeCorrelation": 0.9998725934128352,
      "headCorrelation": 0.9998693847655208,
      "tailCorrelation": 0.9997110154817147,
      "sourceWaveSha256": "57f7cd7c57285958bb1a9563f6ae628be27073c3f31deecd52ab273aff34a2ef",
      "wholePhraseRetained": true
    },
    {
      "id": "t2q1",
      "text": "一つ目。人には理解されにくいこだわり。本棚を背の高さでそろえる。",
      "at": 509,
      "declaredEnd": 517.5,
      "wavSeconds": 4.874666666666666,
      "wholePcmMaxError": 1.1920928955078125e-7,
      "firstVoicedSecond": 0.07329166666666667,
      "lastVoicedSecond": 4.72875,
      "lagSamples": 0,
      "wholeCorrelation": 0.9998806384706038,
      "headCorrelation": 0.9994095967967219,
      "tailCorrelation": 0.9999755321662868,
      "sourceWaveSha256": "fc5a77d8b2f6149751b894eabd9c3ee4e6efd340caa7826c4e49876c740d63fe",
      "wholePhraseRetained": true
    },
    {
      "id": "t2q2",
      "text": "二つ目。自分の機嫌を取る方法。近所をゆっくり歩く。",
      "at": 517.5,
      "declaredEnd": 526,
      "wavSeconds": 4.288,
      "wholePcmMaxError": 1.341104507446289e-7,
      "firstVoicedSecond": 0.07345833333333333,
      "lastVoicedSecond": 4.144916666666667,
      "lagSamples": 0,
      "wholeCorrelation": 0.9999033643764965,
      "headCorrelation": 0.9994141738917535,
      "tailCorrelation": 0.9995071828593205,
      "sourceWaveSha256": "18de4652420ab9b9a02bc46d4d9ccdf51c9c7eb4819236ad05ee2e4535c15616",
      "wholePhraseRetained": true
    },
    {
      "id": "t2q3",
      "text": "三つ目。最近一気見してしまったもの。世界の駅を紹介する番組。",
      "at": 526,
      "declaredEnd": 534.5,
      "wavSeconds": 5.045333333333334,
      "wholePcmMaxError": 1.162290572676028e-7,
      "firstVoicedSecond": 0.0625625,
      "lastVoicedSecond": 4.922395833333334,
      "lagSamples": 0,
      "wholeCorrelation": 0.999875066764166,
      "headCorrelation": 0.9998070275086683,
      "tailCorrelation": 0.9999930421484063,
      "sourceWaveSha256": "4bdd6fe41f4080b79376457e6d172c0ad54e576ac608f8bd6fe0435beca49c57",
      "wholePhraseRetained": true
    },
    {
      "id": "t2q4",
      "text": "四つ目。ひそかに自慢に思っていること。地図を見ずに近所を案内できる。",
      "at": 534.5,
      "declaredEnd": 543,
      "wavSeconds": 4.949333333333334,
      "wholePcmMaxError": 1.341104507446289e-7,
      "firstVoicedSecond": 0.07283333333333333,
      "lastVoicedSecond": 4.827270833333333,
      "lagSamples": 0,
      "wholeCorrelation": 0.9999469037250756,
      "headCorrelation": 0.9999411801324148,
      "tailCorrelation": 0.9999893702993289,
      "sourceWaveSha256": "1129261cbf4a93b13038ad70f8c4e17a00f1812ec95c424261fb9fbcda3cc5f7",
      "wholePhraseRetained": true
    },
    {
      "id": "t2q5",
      "text": "五つ目。送る相手を間違えかけたメッセージ。家族への買い物メモ。",
      "at": 543,
      "declaredEnd": 551.5,
      "wavSeconds": 4.8,
      "wholePcmMaxError": 1.5497207650483347e-7,
      "firstVoicedSecond": 0.06114583333333334,
      "lastVoicedSecond": 4.682083333333333,
      "lagSamples": 0,
      "wholeCorrelation": 0.9998758976256806,
      "headCorrelation": 0.9979658989619531,
      "tailCorrelation": 0.999995357818159,
      "sourceWaveSha256": "8fb485e649d5fdb3b22a8d2f7cb7a36915348947833ef67d6341a6111dfe4c80",
      "wholePhraseRetained": true
    },
    {
      "id": "t2think",
      "text": "真実のみを選べるからといって、毎回そうとは限りません。今回はどの票を置きますか。五つの答えを、もう一度見てみましょう。",
      "at": 551.5,
      "declaredEnd": 562.5,
      "wavSeconds": 8.896,
      "wholePcmMaxError": 1.281499862892943e-7,
      "firstVoicedSecond": 0.07558333333333334,
      "lastVoicedSecond": 8.735770833333333,
      "lagSamples": 0,
      "wholeCorrelation": 0.9999080873707439,
      "headCorrelation": 0.9999129305381059,
      "tailCorrelation": 0.9999940243081409,
      "sourceWaveSha256": "c8b15d8cfc42f191041064ac9d74fe80856dd61e2256ad119ada42f8d5509e18",
      "wholePhraseRetained": true
    },
    {
      "id": "t2reveal",
      "text": "真実のみへの票は外れ。今回は三番に嘘を入れていました。設定を有効にしても、毎回宣言するわけではありません。ビービーが二点です。",
      "at": 567.5,
      "declaredEnd": 580,
      "wavSeconds": 10.122666666666667,
      "wholePcmMaxError": 1.1920928955078125e-7,
      "firstVoicedSecond": 0.07789583333333333,
      "lastVoicedSecond": 9.9468125,
      "lagSamples": 0,
      "wholeCorrelation": 0.9999029797524194,
