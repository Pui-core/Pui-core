      "wholePhraseRetained": true
    },
    {
      "id": "r2q5",
      "text": "五つ目。テスト前にやりがちだったこと。机の片づけ。",
      "at": 187,
      "declaredEnd": 195.5,
      "wavSeconds": 3.8506666666666667,
