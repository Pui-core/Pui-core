      "wholePhraseRetained": true
    },
    {
      "id": "r2q3",
      "text": "三つ目。疲れた日に食べると回復するもの。温かい味噌汁。",
      "at": 170,
      "declaredEnd": 178.5,
      "wavSeconds": 4.234666666666667,
