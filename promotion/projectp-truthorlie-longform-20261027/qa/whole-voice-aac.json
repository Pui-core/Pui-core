      "sourceWaveSha256": "6980e6e03667797537f8266f575b6414b844b19aca40d30032cee8536057d429",
      "wholePhraseRetained": true
    },
    {
      "id": "r2intro",
      "text": "二ラウンド目は、操作例ビービーの出題です。答える役と推理する役を交代して、別の五つを見てみましょう。",
      "at": 144,
      "declaredEnd": 153,
      "wavSeconds": 7.594666666666667,
      "wholePcmMaxError": 1.1920928955078125e-7,
