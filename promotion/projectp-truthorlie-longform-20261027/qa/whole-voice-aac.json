      "sourceWaveSha256": "87af2c9988595555d9ac8ed09dd79a07843a6892552632acac4cb609a76f37b1",
      "wholePhraseRetained": true
    },
    {
      "id": "r2q4",
      "text": "四つ目。休日に時間を忘れてしまうこと。小説を読むこと。",
      "at": 178.5,
      "declaredEnd": 187,
      "wavSeconds": 4.565333333333333,
