      "sourceWaveSha256": "6a5deab467262ca0455257bedb7afc5355a04ba5ed2432de8ee1ab1532a994c2",
      "wholePhraseRetained": true
    },
    {
      "id": "r3q1",
      "text": "一つ目。ひそかに自慢に思っていること。毎朝の散歩が一年続いた。",
      "at": 237,
      "declaredEnd": 245.5,
      "wavSeconds": 5.141333333333334,
      "wholePcmMaxError": 1.281499862892943e-7,
      "firstVoicedSecond": 0.07333333333333333,
      "lastVoicedSecond": 4.989354166666667,
