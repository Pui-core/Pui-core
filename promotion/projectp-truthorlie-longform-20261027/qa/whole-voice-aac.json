      "wholePhraseRetained": true
    },
    {
      "id": "r2q2",
      "text": "二つ目。買う前にレビューを見すぎるもの。ワイヤレスイヤホン。",
      "at": 161.5,
      "declaredEnd": 170,
      "wavSeconds": 4.277333333333333,
      "wholePcmMaxError": 1.3709068302780736e-7,
