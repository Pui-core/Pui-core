      "declaredEnd": 254,
      "wavSeconds": 3.541333333333333,
      "wholePcmMaxError": 1.1920928955078125e-7,
      "firstVoicedSecond": 0.0734375,
      "lastVoicedSecond": 3.3800416666666666,
