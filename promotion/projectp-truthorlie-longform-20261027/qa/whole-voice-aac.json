      "sourceWaveSha256": "9e52ecdcc337bb66c1f72d6b142c7e51a9cb6f778479a28553a20c1353028cfd",
      "wholePhraseRetained": true
    },
    {
      "id": "r1reveal",
      "text": "今回は三番に投票。結果は、投票的中。嘘に設定したのは、赤い自転車でした。操作例ビービーに一点。スコアは零対一です。",
      "at": 127.5,
      "declaredEnd": 140,
      "wavSeconds": 10.645333333333333,
      "wholePcmMaxError": 1.3113021857247276e-7,
      "firstVoicedSecond": 0.07845833333333334,
      "lastVoicedSecond": 10.462729166666668,
      "lagSamples": 0,
      "wholeCorrelation": 0.9999073568360551,
      "headCorrelation": 0.999971383623832,
      "tailCorrelation": 0.9998828762375245,
      "sourceWaveSha256": "1c21c9ddcadbe471bb91e0a1c3ebb7eb6d01859498cbfa6bfce3ea8ccececdde",
      "wholePhraseRetained": true
    },
    {
      "id": "r1bridge",
      "text": "次は役割を交代して、別の五つを見てみます。",
      "at": 140,
      "declaredEnd": 144,
      "wavSeconds": 3.488,
      "wholePcmMaxError": 1.1175870895385742e-7,
