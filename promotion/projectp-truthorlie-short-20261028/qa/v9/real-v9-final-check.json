      "predictedDuration": 2.6869938857892977,
      "speed": 1.13,
      "kana": "トオヒョオワ'/ニ'バン、デ'モ、ウ'ソワ/ゴ'バン",
      "actualDuration": 2.688,
      "firstVoiced": 6.382416666666667,
      "lastVoiced": 8.904020833333334,
      "sourceTailPad": 0.10395833333333333,
      "maxSourcePcmError": 0
    },
    {
      "id": "result",
      "at": 9.76,
      "end": 13.45,
      "text": "全員が外したので、出題側に一点。",
