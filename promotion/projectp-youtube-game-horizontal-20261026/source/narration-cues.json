[
  {"at":0.15,"end":3.85,"text":"たどり着いたのに、思い出が一つ消えた。","kind":"editorial-summary"},
  {"at":4.2,"end":7.45,"text":"自作ゲーム、エンバーウェイク。","kind":"editorial-introduction"},
  {"at":7.9,"end":11.35,"text":"覚えてる？ あの日の約束。","kind":"recorded-Lumi-dialogue-quotation"},
  {"at":11.9,"end":15.35,"text":"当たり前だろ。絶対迎えに行く。","kind":"recorded-Ash-dialogue-quotation"},
  {"at":15.8,"end":19.35,"text":"公園の灯をつないで、鐘楼への道を開く。","kind":"recorded-objective-paraphrase"},
  {"at":22.5,"end":26.2,"text":"光を集めて、炉に火を灯す。","kind":"actual-interaction-explanation"},
  {"at":29.8,"end":33.6,"text":"スイッチで、次の足場が現れる。","kind":"actual-interaction-explanation"},
  {"at":45.2,"end":49.3,"text":"三つ目の灯。この先で、何を失うのか。","kind":"editorial-question"},
  {"at":50.4,"end":54.4,"text":"あの公園で、何をしてたんだっけ。","kind":"recorded-Ash-dialogue-quotation"},
  {"at":55.3,"end":59.1,"text":"ルミ。君だけは、忘れない。","kind":"recorded-Ash-dialogue-quotation"},
  {"at":63.3,"end":68.5,"text":"失った記憶。公園でルミと走り回った午後。","kind":"recorded-journal-quotation"},
  {"at":69.3,"end":74.6,"text":"名前は覚えている。でも、あの午後の思い出が消えた。","kind":"editorial-summary"},
  {"at":75.3,"end":80.8,"text":"名前を覚えているうちに、迎えに行けるだろうか。","kind":"editorial-next-question"}
]
