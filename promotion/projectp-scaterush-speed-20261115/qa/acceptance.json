    "voiceIntervals": {
      "subjectiveListen": false,
      "cues": [
        {
          "at": 0,
          "text": "ブーストしっぱなしで、避けきれる？",
          "file": "/home/pui/private-use/projectp-scaterush162-20261115/media/voice-0.wav",
          "sha256": "b83c195726138aa85d300036bfd83e3ed2747176027979d7ca34ecacbc6d272f",
          "end": 2.8,
          "duration": 2.3573333333333335,
          "firstVoiced": 0.06747916666666667,
          "lastVoiced": 2.2309791666666667,
          "peak": 0.41436767578125
        },
        {
          "at": 2.8,
          "text": "スケートラッシュの、ウェブ試作版で試します。",
          "file": "/home/pui/private-use/projectp-scaterush162-20261115/media/voice-1.wav",
          "sha256": "937c38306df34a1002190fc2f95ffbd7e4ec2fd1d7a9eb66b8b9c4d502b9eed7",
          "end": 6.6,
          "duration": 2.997333333333333,
          "firstVoiced": 2.8629791666666664,
          "lastVoiced": 5.6314375,
          "peak": 0.429931640625
        },
        {
          "at": 6.6,
          "text": "加速したまま、跳んで、くぐって。",
          "file": "/home/pui/private-use/projectp-scaterush162-20261115/media/voice-2.wav",
          "sha256": "4ed1fd39f6a777c2af66d3fb2c69c8507f11fd2c5dace115408cbf9b74846770",
          "end": 10,
          "duration": 2.7306666666666666,
          "firstVoiced": 6.667020833333333,
          "lastVoiced": 9.2005625,
          "peak": 0.385467529296875
        },
        {
          "at": 10,
          "text": "このあと、冒頭の衝突に。",
          "file": "/home/pui/private-use/projectp-scaterush162-20261115/media/voice-3.wav",
          "sha256": "0ebe015e415a0863cc94cd87329ee402e17808f7b83540b7d96e94cf24cb0bbf",
          "end": 13,
          "duration": 2.208,
          "firstVoiced": 10.0661875,
          "lastVoiced": 12.059145833333334,
          "peak": 0.488983154296875
        },
        {
          "at": 13,
          "text": "今度は、障害物の手前で減速。",
          "file": "/home/pui/private-use/projectp-scaterush162-20261115/media/voice-4.wav",
          "sha256": "a64a7792c9d48ef9e0ab549de3fd94d7922bc8271edfb578b4403abb324b8dda",
          "end": 17,
          "duration": 2.6773333333333333,
          "firstVoiced": 13.068,
          "lastVoiced": 15.560041666666667,
          "peak": 0.449066162109375
        },
        {
          "at": 17,
          "text": "跳び越えたら、また加速します。",
          "file": "/home/pui/private-use/projectp-scaterush162-20261115/media/voice-5.wav",
          "sha256": "f2c693f568bee21fdfaaa6e4620ca9cb90cd6218524129c83803de4d3d4e4e23",
          "end": 21,
          "duration": 2.1653333333333333,
          "firstVoiced": 17.064625,
          "lastVoiced": 19.001541666666668,
          "peak": 0.4034423828125
        },
        {
          "at": 21,
          "text": "速さを切り替えながら、先へ。",
          "file": "/home/pui/private-use/projectp-scaterush162-20261115/media/voice-6.wav",
          "sha256": "b38cae40a953f4020398255ec9b940f00606ef73a57a16fac215f855eb4e6de1",
          "end": 25,
          "duration": 2.538666666666667,
          "firstVoiced": 21.076208333333334,
          "lastVoiced": 23.404375,
          "peak": 0.36279296875
        },
        {
          "at": 25,
          "text": "障害物の並びは、走行ごとに違います。",
          "file": "/home/pui/private-use/projectp-scaterush162-20261115/media/voice-7.wav",
          "sha256": "8a17acdaa9a0bffd846b579f1f7fbf12a23444d1e1010492d9d76af274930534",
          "end": 29.5,
          "duration": 3.104,
          "firstVoiced": 25.0694375,
          "lastVoiced": 27.941125,
          "peak": 0.3956298828125
        },
        {
          "at": 29.5,
          "text": "ここは加速？ それとも、減速？",
          "file": "/home/pui/private-use/projectp-scaterush162-20261115/media/voice-v03-8.wav",
          "sha256": "ab3d601d5b5fa3445b8a177f296669ce627fbe816aab03733d95322534f4a784",
          "end": 34,
          "supersedes": "/home/pui/private-use/projectp-scaterush162-20261115/media/voice-8.wav",
          "duration": 2.986666666666667,
          "firstVoiced": 29.56775,
          "lastVoiced": 32.3563125,
          "peak": 0.37255859375
        },
        {
          "at": 34,
          "text": "次の障害物まで、どうつなぐ？",
          "file": "/home/pui/private-use/projectp-scaterush162-20261115/media/voice-v03-9.wav",
          "sha256": "020566ea2a63f6729f690323be85b313e7eaadf6b068e8032069c81dedbeedfb",
          "end": 38,
          "supersedes": "/home/pui/private-use/projectp-scaterush162-20261115/media/voice-9.wav",
          "duration": 2.485333333333333,
          "firstVoiced": 34.065875,
          "lastVoiced": 36.35825,
          "peak": 0.451751708984375
        },
        {
          "at": 38,
          "text": "次も、障害物が近づきます。",
          "file": "/home/pui/private-use/projectp-scaterush162-20261115/media/voice-10.wav",
          "sha256": "c9a0e008e2c3acccdcae418884f15d8e4ff58e51808fa95da3854b686cfd436f",
          "end": 41,
          "duration": 2.3573333333333335,
          "firstVoiced": 38.06585416666667,
          "lastVoiced": 40.19445833333333,
          "peak": 0.41131591796875
        },
        {
          "at": 41,
          "text": "くぐる操作も使います。",
          "file": "/home/pui/private-use/projectp-scaterush162-20261115/media/voice-11.wav",
          "sha256": "09f935f6c80f2de800230e3681a9805796ca703c0eef76bfeab9be1b523702e8",
          "end": 45.3,
          "duration": 1.5466666666666666,
          "firstVoiced": 41.068083333333334,
          "lastVoiced": 42.38379166666667,
          "peak": 0.43341064453125
        },
        {
          "at": 45.3,
          "text": "この走行も、最後は衝突。",
          "file": "/home/pui/private-use/projectp-scaterush162-20261115/media/voice-12.wav",
          "sha256": "6b24bd41c356ce80948b552e989ab55710ce6ec73fbc57c6092aeb88554a3ebb",
          "end": 49.1,
          "duration": 2.4106666666666667,
          "firstVoiced": 45.36914583333333,
          "lastVoiced": 47.569229166666666,
          "peak": 0.407623291015625
        },
        {
          "at": 49.1,
          "text": "速いだけでなく、切り替えるタイミングも。",
          "file": "/home/pui/private-use/projectp-scaterush162-20261115/media/voice-13.wav",
          "sha256": "ca6ca3b065245bfcb34b80503cd84c693f31159def763584f451d76f25b129c5",
          "end": 52.5,
          "duration": 2.656,
          "firstVoiced": 49.1739375,
          "lastVoiced": 51.601416666666665,
          "peak": 0.375640869140625
        },
        {
          "at": 52.5,
          "text": "アイフォーン版は、アップストアで、スケートラッシュを検索。",
          "file": "/home/pui/private-use/projectp-scaterush162-20261115/media/voice-14.wav",
          "sha256": "9e23da861a311fdcdcde002252f766ad6137a564ee50819f3bcfb844af434e38",
          "end": 57.3,
          "duration": 4,
          "firstVoiced": 52.557604166666664,
          "lastVoiced": 56.381479166666665,
          "peak": 0.566192626953125
        },
        {
          "at": 57.3,
          "text": "正式なリンクは、投稿文に。",
          "file": "/home/pui/private-use/projectp-scaterush162-20261115/media/voice-15.wav",
          "sha256": "fcff969b8354e7756f134ef24c267c640dd9b5e48dc2c6334717384c330e1c09",
          "end": 60.3,
          "duration": 2.3893333333333335,
          "firstVoiced": 57.368624999999994,
          "lastVoiced": 59.540104166666666,
          "peak": 0.38592529296875
        },
        {
          "at": 60.3,
          "text": "別作、エンバーウェイクも開発中。支援はキャンプファイヤーで。",
          "file": "/home/pui/private-use/projectp-scaterush162-20261115/media/voice-16.wav",
          "sha256": "57c047fb490f29fdf978afb79509d9c5b4e8ad85de4d4017a15483c7d1d2a6ca",
          "end": 65,
