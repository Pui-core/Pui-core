{
  "speaker": "青山龍星",
  "style": "ノーマル",
  "styleId": 13,
  "credit": "VOICEVOX:青山龍星",
  "engineVersion": "0.25.1",
  "cues": [
    {
      "at": 0.1,
      "end": 3.15,
      "text": "その一手で、何秒縮める？",
      "duration": 2.165333,
      "endActual": 2.265333,
      "sha256": "ebc537e738234425965a8562de1060d3f85f07e5913dd8b5c87770e3f74b3a71"
    },
    {
      "at": 3.6,
      "end": 9.65,
      "text": "灯を運ぶ、ツーディーアクション。エンバーウェイク。",
      "duration": 3.061333,
      "endActual": 6.661333,
      "sha256": "b6b720a51a759652764fa4c53da529ffe899a755e197538a68d45e81e84118ff"
    },
    {
      "at": 9.95,
      "end": 12.3,
      "text": "同じコースで、自己ベストへ。",
      "duration": 1.930667,
      "endActual": 11.880666999999999,
      "sha256": "5d11229c1c5ec02d05d675e0b6760fdd9da0771b4721fb32685721204bb9e4df"
    },
    {
      "at": 12.5,
      "end": 17.9,
      "text": "運ぶ。はめる。道が変わる。",
      "duration": 2.261333,
      "endActual": 14.761333,
      "sha256": "f8cb810fea51839d90d2812633490500b4ec5b406bcc2959fbbca1d00b4d6b68"
    },
    {
      "at": 18.85,
      "end": 22.8,
      "text": "着地点を狙って、跳ぶ。",
      "duration": 2.176,
      "endActual": 21.026000000000003,
      "sha256": "8c458c4ee8be47f569938b5d749b33efc87637081ae2ca3d6e8c368e23b3db87"
    },
    {
      "at": 36.85,
      "end": 39.95,
      "text": "全五章のデモから、本制作へ。",
      "duration": 2.282667,
      "endActual": 39.132667,
      "sha256": "940d89143432429ea2646854d2b4f294e76a0d191a793bf8e21304e61ed40d92"
    },
    {
      "at": 48.2,
      "end": 52.8,
      "text": "クラウドファンディングは、公開準備中。",
      "duration": 2.453333,
      "endActual": 50.653333,
      "sha256": "4d2bf8a730f3dfaa20c347c89c6e3d4968fe900e6603469d5c2fe59ab33def44"
    },
    {
      "at": 54,
      "end": 59.5,
      "text": "この制作を、フォローで応援してください。",
      "duration": 2.538667,
      "endActual": 56.538667,
      "sha256": "a42dd6ff5e35384db618deee8af2045af42bf410e93fdcc68607cbf636cd5485"
    }
  ],
  "directAudition": false,
  "voiceImpersonation": false
}
