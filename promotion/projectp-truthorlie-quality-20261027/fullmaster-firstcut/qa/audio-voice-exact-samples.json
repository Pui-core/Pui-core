  "maxSourcePeak": 0.5284423828125,
  "cues": [
    {
      "id": "hook",
      "at": 0.2,
      "end": 3.4,
      "text": "この一票、誰の得点になる？",
      "file": "voice-hook.wav",
      "predictedDuration": 2.254140830543535,
      "speedScale": 1.16,
      "sha256": "cbf1f0817100b22270653f0b4f0895fa78d1950a5c8e18f5b3a457c03674eba1",
      "atSample": 9600,
      "sourceFrames": 113152
    },
    {
      "id": "rule",
      "at": 3.8,
      "end": 9.6,
      "text": "的中で一点。全員外すと、出題した側に一点です。",
      "file": "voice-rule.wav",
      "predictedDuration": 4.147232982917079,
      "speedScale": 1.16,
      "sha256": "8b7bed64b16ceb4b55c71fb711b85f3542265f8f067d4e83d4f60d3ade243d77",
      "atSample": 182400,
      "sourceFrames": 198144
    },
    {
      "id": "case1",
      "at": 10,
      "end": 13.8,
      "text": "嘘は三番。三番に投票します。",
      "file": "voice-case1.wav",
      "predictedDuration": 2.6439064767237372,
      "speedScale": 1.16,
      "sha256": "f4b78ea826aa3f71ddcffe18efc2fe5ce57042a014df37bfb2700745e4c667fc",
      "atSample": 480000,
      "sourceFrames": 124928
    },
    {
      "id": "hit",
      "at": 16,
      "end": 20.5,
      "text": "投票的中。推理するBBに一点。",
      "file": "voice-hit.wav",
      "predictedDuration": 2.811413551240132,
      "speedScale": 1.16,
      "sha256": "d4930d930bbdb38e8ef7d36b748de8b55f44ae3ce2ff3d56538822cd3bddbfa1",
      "atSample": 768000,
      "sourceFrames": 135680
    },
    {
      "id": "switch",
      "at": 21,
      "end": 23.8,
      "text": "今度は、出題と推理を交代。",
      "file": "voice-switch.wav",
      "predictedDuration": 2.2729554862708885,
      "speedScale": 1.16,
      "sha256": "e3b7803f11b43f4d13fe5b26b837f699ad220f8b381ddd96b242ce913fe7900d",
      "atSample": 1008000,
      "sourceFrames": 108544
    },
    {
      "id": "case2",
      "at": 24,
      "end": 28.8,
      "text": "嘘は五番。でも、二番に投票。",
      "file": "voice-case2.wav",
      "predictedDuration": 2.9130340689112404,
      "speedScale": 1.16,
      "sha256": "14562e611e1a96e87c491b4830788fed45af12ffe12931cb1bccb026b761e489",
      "atSample": 1152000,
      "sourceFrames": 137216
    },
    {
      "id": "miss",
      "at": 30,
      "end": 34.6,
      "text": "正解者なし。出題したBBに一点。",
      "file": "voice-miss.wav",
      "predictedDuration": 2.8719211806922127,
      "speedScale": 1.16,
      "sha256": "d124c15f9e5295715566df869b5f55f35589088eda5b25132910b736792d4bf0",
      "atSample": 1440000,
      "sourceFrames": 136192
    },
    {
      "id": "consequence",
      "at": 35,
      "end": 41,
      "text": "見抜いても、だましても。同じBBが、別の取り方で得点しました。",
      "file": "voice-consequence.wav",
      "predictedDuration": 4.663255788940808,
      "speedScale": 1.16,
      "sha256": "450476b21fe26335560dfe9b22518fbf04f77893cffd7d20d780f576e1f71cfe",
      "atSample": 1680000,
      "sourceFrames": 223744
    },
    {
      "id": "next",
      "at": 41.1,
      "end": 44,
      "text": "嘘か誠か。次は、嘘がない回。",
      "file": "voice-next.wav",
      "predictedDuration": 2.702316465860811,
      "speedScale": 1.16,
      "sha256": "9989a2dca9cb5ff1e26af56afb70b6974f0b22b9355249418b92ee61ee367935",
      "atSample": 1972800,
      "sourceFrames": 128512
    },
    {
      "id": "d2-01",
      "text": "五つとも本当の回です。BBは二番へ投票。点を取るのは、どちらでしょう。",
      "file": "voice-d2-01.wav",
      "predictedDuration": 5.419099007228326,
      "sourceWaveSeconds": 5.365333333333333,
      "speedScale": 1.16,
      "sha256": "377ab7f5a9d943cc282bc5fdd362f9fc50143cb672229b0ec1dccff52c4d0459",
      "at": 44.1,
      "end": 49.613333,
      "atSample": 2116800,
      "sourceFrames": 257536
    },
    {
      "id": "d2-02",
      "text": "出題したAAに一点。真実のみは回の状態で、二番への投票は的中していません。",
      "file": "voice-d2-02.wav",
      "predictedDuration": 5.851069693976435,
      "sourceWaveSeconds": 5.8133333333333335,
      "speedScale": 1.16,
      "sha256": "f7693b0735bda7b44cf315ae18632c1658091225f7e70af7f95880feff302ade",
      "at": 50.833333,
      "end": 56.78,
      "atSample": 2440000,
      "sourceFrames": 279040
    },
    {
      "id": "d2-03",
      "text": "別ラウンドの全部本当では、真実のみを選んだBBに一点。",
      "file": "voice-d2-03.wav",
      "predictedDuration": 4.02471357382577,
      "sourceWaveSeconds": 4.032,
      "speedScale": 1.16,
      "sha256": "34fafeb6cc47ff2df762373ec889c7783c4f779f8c767d8d0299eb859240b743",
      "at": 57,
      "end": 61.18,
      "atSample": 2736000,
      "sourceFrames": 193536
    },
    {
      "id": "d2-04",
      "text": "今度は嘘三番があるのに、真実のみへ。外れたので、出題BBに一点です。",
      "file": "voice-d2-04.wav",
      "predictedDuration": 5.512923584200185,
      "sourceWaveSeconds": 5.514666666666667,
      "speedScale": 1.16,
      "sha256": "e6adae27d0eb16530b713eefd0c2e06acbca5e089ca4a1e36b03f621239ec7c2",
      "at": 61.4,
      "end": 67.046667,
      "atSample": 2947200,
      "sourceFrames": 264704
    },
    {
      "id": "d2-05",
      "text": "状態と投票が合えば推理側。誰も合わなければ出題側。三例は、この分かれ目です。",
      "file": "voice-d2-05.wav",
      "predictedDuration": 5.853554558949224,
      "sourceWaveSeconds": 5.898666666666666,
      "speedScale": 1.16,
      "sha256": "6e5a65a3d114a0f6874dfb53939a70bac0aa7debccb6f6bc939011568814e063",
      "at": 67.266667,
      "end": 73.313333,
      "atSample": 3228800,
      "sourceFrames": 283136
    },
    {
      "id": "d3-01",
      "text": "出題側は五つを入力し、三番を嘘に指定。受け渡し前には、その印が見えています。",
      "file": "voice-d3-01.wav",
      "predictedDuration": 6.407742758547438,
      "sourceWaveSeconds": 6.421333333333333,
      "speedScale": 1.16,
      "sha256": "cf6e5431413de09814beaaae200847b0cbac991c61d67bc1067eaf020e24d91c",
      "at": 73.533333,
      "end": 80.113333,
      "atSample": 3529600,
      "sourceFrames": 308224
    },
    {
      "id": "d3-02",
      "text": "推理側の同じ回答には、印がありません。指定された嘘を見せずに、一票を選ぶ場面へ切り替わります。",
      "file": "voice-d3-02.wav",
      "predictedDuration": 7.016033445493928,
      "sourceWaveSeconds": 6.997333333333334,
      "speedScale": 1.16,
      "sha256": "539216c52e32e5d85eebb98e7a89e3e9d858703faa6189a60f89fc9eeec96cf6",
      "at": 80.333333,
      "end": 87.48,
      "atSample": 3856000,
      "sourceFrames": 335872
    },
    {
      "id": "d3-03",
      "text": "結果で、嘘と投票を照合。的中なら同じ三番に二つの印。外れた実例は、投票二番と嘘五番です。",
      "file": "voice-d3-03.wav",
      "predictedDuration": 7.709326778804434,
      "sourceWaveSeconds": 7.744,
      "speedScale": 1.16,
      "sha256": "35976021808969f8c2e2aa432cf776bc8f83f6f3b9d4f877b54a2dd8c4628124",
      "at": 87.7,
      "end": 95.58,
      "atSample": 4209600,
      "sourceFrames": 371712
    },
    {
      "id": "d4-01",
      "text": "三人の計算例です。配点一、連続オフ。Aが出題し、Bだけが的中したら、Aにも点が入る？",
      "file": "voice-d4-01.wav",
      "predictedDuration": 7.828139202903057,
      "sourceWaveSeconds": 7.946666666666666,
      "speedScale": 1.16,
      "sha256": "27ecf47f0206b1ea3e9045ca543cf752b27fa1d20063ead29e08cb97e776b5eb",
      "at": 95.8,
      "end": 103.88,
      "atSample": 4598400,
      "sourceFrames": 381440
    },
    {
      "id": "d4-02",
      "text": "Bに一点、AとCは零。一人でも正解がいれば、全員外れにはなりません。",
      "file": "voice-d4-02.wav",
      "predictedDuration": 5.601299185475399,
      "sourceWaveSeconds": 5.6,
      "speedScale": 1.16,
      "sha256": "d531f01f87d46e686f8fbe5072e8445767afe8db7fef3f8969aec90951159cdd",
      "at": 105.1,
      "end": 110.846667,
      "atSample": 5044800,
      "sourceFrames": 268800
    },
    {
      "id": "d4-03",
      "text": "BもCも的中したら、一点を山分け？それとも、それぞれ一点でしょうか。",
      "file": "voice-d4-03.wav",
      "predictedDuration": 5.167835704252638,
      "sourceWaveSeconds": 5.237333333333333,
      "speedScale": 1.16,
      "sha256": "4a96cf7d427f9fb2c571382a4bc2f8157e1e251a51c9dd2185fff914dd12dc6e",
      "at": 111.066667,
      "end": 116.446667,
      "atSample": 5331200,
      "sourceFrames": 251392
    },
    {
      "id": "d4-04",
      "text": "それぞれ一点。正解した投票ごとの加点です。",
      "file": "voice-d4-04.wav",
      "predictedDuration": 3.2552313612350106,
      "sourceWaveSeconds": 3.2,
      "speedScale": 1.16,
      "sha256": "33ba085314999b88236ff56e742084c82fb00ab33d10a14d7c26d14d0b2c4161",
      "at": 117.666667,
      "end": 121.013333,
      "atSample": 5648000,
      "sourceFrames": 153600
    },
    {
      "id": "d4-05",
      "text": "二人とも外すと、出題したAに一点。全員が外れたときの分岐です。",
      "file": "voice-d4-05.wav",
      "predictedDuration": 4.743123925492681,
      "sourceWaveSeconds": 4.704,
      "speedScale": 1.16,
      "sha256": "d0a2ade3f3c01b7986bc46ada75de672de93cc6472bc6a7edaf6dc9f96aa9966",
      "at": 121.233333,
      "end": 126.08,
      "atSample": 5819200,
      "sourceFrames": 225792
    },
    {
      "id": "d5-01",
      "text": "ここも計算例。基本二、連続オン。BBの最初の的中は、何点でしょう。",
      "file": "voice-d5-01.wav",
      "predictedDuration": 5.8979659540797105,
      "sourceWaveSeconds": 5.8453333333333335,
      "speedScale": 1.16,
      "sha256": "aa804e4fa3794509ff1bde5ea4a8223eed565ab21b1047a7f1269daa14dc6e2b",
      "at": 126.3,
      "end": 132.28,
      "atSample": 6062400,
      "sourceFrames": 280576
    },
    {
      "id": "d5-02",
      "text": "前回までの連続が零なので、今回は二点。累計は零から二です。",
      "file": "voice-d5-02.wav",
      "predictedDuration": 4.466047835545293,
      "sourceWaveSeconds": 4.448,
      "speedScale": 1.16,
      "sha256": "f647dd8a65b4fef0fdbddc6539428d2930b3235cc7d42a306db7a6c13f2f7aae",
      "at": 133.5,
      "end": 138.08,
      "atSample": 6408000,
      "sourceFrames": 213504
    },
    {
      "id": "d5-03",
      "text": "次のAAの的中はAAに二点。BBの次の推理も当たると、今度は二点？三点？",
      "file": "voice-d5-03.wav",
      "predictedDuration": 6.1088639318326425,
      "sourceWaveSeconds": 6.378666666666667,
      "speedScale": 1.16,
      "sha256": "0ca625d8905fe78ab1e45ae6f1b3f3cdebe379a3652f411754c1006cbcb884d8",
      "at": 138.3,
      "end": 144.813333,
      "atSample": 6638400,
      "sourceFrames": 306176
    },
    {
      "id": "d5-04",
      "text": "基本二に連続分一を足して、今回三点。BB累計は二から五。今回五点ではありません。",
      "file": "voice-d5-04.wav",
      "predictedDuration": 6.272374341498161,
      "sourceWaveSeconds": 6.293333333333333,
      "speedScale": 1.16,
      "sha256": "df1c9786d5312e0a60c34a95ce0f5e2b12b1c52215f26bc2112b74ee62cfe112",
      "at": 146.033333,
      "end": 152.48,
      "atSample": 7009600,
      "sourceFrames": 302080
    },
    {
      "id": "d5-05",
      "text": "連続をオフに置けば、同じ二回の的中は二と二で合計四。オンなら二と三で五です。",
      "file": "voice-d5-05.wav",
      "predictedDuration": 5.392156911348475,
      "sourceWaveSeconds": 5.386666666666667,
      "speedScale": 1.16,
      "sha256": "783bdb61060f5037a7f7222815d3a913a31b533e9b3da8337110b0cd06efe9db",
      "at": 152.7,
      "end": 158.246667,
      "atSample": 7329600,
      "sourceFrames": 258560
    },
    {
      "id": "d5-06",
      "text": "BB自身の外れが間に入ると連続は零へ。次の推理的中は基本二に戻り、推理加点は二、零、二です。",
      "file": "voice-d5-06.wav",
      "predictedDuration": 8.261362043218366,
      "sourceWaveSeconds": 8.266666666666667,
      "speedScale": 1.16,
      "sha256": "f15bc7a307e4364a2b53bc710bdf84a8b2458316866259a6917fc2149e9d6440",
      "at": 158.466667,
      "end": 166.88,
      "atSample": 7606400,
      "sourceFrames": 396800
    },
    {
      "id": "d6-01",
      "text": "実四ラウンドへ戻ると、AAは三回目に出題で一点、最後は二番を見抜いて一点。",
      "file": "voice-d6-01.wav",
      "predictedDuration": 5.863879875417413,
      "sourceWaveSeconds": 5.8133333333333335,
      "speedScale": 1.16,
      "sha256": "1b60d2eff74cb1bb527ac90874fe3d01c3aaf5de61aba9c9907844ab0dded347",
      "at": 167.1,
      "end": 173.046667,
      "atSample": 8020800,
      "sourceFrames": 279040
    },
    {
      "id": "d6-02",
      "text": "最終は二対二で、引き分け。二点に届いたこと自体が、勝ちを決めたわけではありません。",
      "file": "voice-d6-02.wav",
      "predictedDuration": 5.6419136105837495,
      "sourceWaveSeconds": 5.664,
      "speedScale": 1.16,
      "sha256": "d2775667e36cc040c094aed177f528beddce9a0b10dfc60cf7c691e01de0af9d",
      "at": 173.266667,
      "end": 179.08,
      "atSample": 8316800,
      "sourceFrames": 271872
    },
    {
      "id": "d6-03",
      "text": "別の三ラウンドは一対二でBBが勝利。同じ二点でも、相手の累計と試合条件が違います。",
      "file": "voice-d6-03.wav",
      "predictedDuration": 6.066713222696864,
      "sourceWaveSeconds": 6.005333333333334,
      "speedScale": 1.16,
      "sha256": "cfb00b04fa2c297ba764e4538f1273de4e8ac08aa2b256330446a9d1fc47daeb",
      "at": 179.3,
      "end": 185.446667,
      "atSample": 8606400,
      "sourceFrames": 288256
    },
    {
      "id": "d6-04",
      "text": "完了した試合は履歴へ。三ラウンドの勝利と四ラウンドの引き分けを、別の記録として確認できます。",
      "file": "voice-d6-04.wav",
      "predictedDuration": 6.055401442934727,
      "sourceWaveSeconds": 6.0906666666666665,
      "speedScale": 1.16,
      "sha256": "5c46e145d8c39f8c00e8cf455eec9f2452b97e0d0c403f4afd27718fe28cdae7",
      "at": 185.666667,
      "end": 191.913333,
      "atSample": 8912000,
      "sourceFrames": 292352
    },
    {
      "id": "d6-05",
      "text": "どの選択が、誰の点になるか。回の状態と投票を照合して、今回の獲得と累計を分けて追います。",
      "file": "voice-d6-05.wav",
      "predictedDuration": 6.905267070377695,
      "sourceWaveSeconds": 6.9013333333333335,
      "speedScale": 1.16,
      "sha256": "c228004d52e6a55b1c8157a68c36ad74827df60e6f0de58061b7fd9128fbdfff",
      "at": 192.133333,
      "end": 199.18,
      "atSample": 9222400,
      "sourceFrames": 331264
    },
    {
      "id": "d6-06",
      "text": "自作ゲーム、嘘か誠か。次は、自分たちの答えで。",
      "file": "voice-d6-06.wav",
      "predictedDuration": 4.073299291616884,
      "sourceWaveSeconds": 4.085333333333334,
      "speedScale": 1.16,
      "sha256": "9ab95614a00a95a8611b7657543efc247d25f2c055361e92640ad9174274146f",
      "at": 199.4,
      "end": 203.646667,
      "atSample": 9571200,
      "sourceFrames": 196096
    }
  ],
  "allNewVoices": false,
