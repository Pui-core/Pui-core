    },
    {
      "id": "branch-answer",
      "at": 84.33333333333333,
      "end": 89.16666666666667,
      "text": "二枚とも着地できました。近道は、同じ島へつながります。",
      "caption": "二枚とも着地。\n近道も、同じ島へ。",
      "kind": "commentary",
