      "speedScale": 1.06,
      "sha256": "bf39e683ab1c56c9c4582864e0460936127a525981a7120ed144255eca49556b"
    },
    {
      "id": "first-cost",
      "at": 51.1,
      "end": 54.9,
      "text": "失ったのは、公園で過ごした午後。",
      "caption": "失ったのは、公園で過ごした午後。",
      "kind": "commentary",
      "file": "voice-03.wav",
