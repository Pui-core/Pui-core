{
  "sourceCommit": "71584a6bd0c8852885157de71032fd9252e7a04c",
  "quotes": [
    {
      "id": "u003",
      "ep": 1,
      "field": "intro",
      "index": 0,
      "exactRawTextMatches": true,
      "text": "アッシュ、覚えてる？ あの日の約束。"
    },
    {
      "id": "u004",
      "ep": 1,
      "field": "intro",
      "index": 1,
      "exactRawTextMatches": true,
      "text": "当たり前だろ。絶対迎えに行く。"
    },
    {
      "id": "u009",
      "ep": 1,
      "field": "outro",
      "index": 0,
      "exactRawTextMatches": true,
      "text": "あの公園で、何をしてたんだっけ。"
    },
    {
      "id": "u010",
      "ep": 1,
      "field": "outro",
      "index": 1,
      "exactRawTextMatches": true,
      "text": "……私の名前は、まだわかる？"
    },
    {
      "id": "u011",
      "ep": 1,
      "field": "outro",
      "index": 2,
      "exactRawTextMatches": true,
      "text": "ルミ。君だけは、忘れない。"
    },
    {
      "id": "u012",
      "ep": 1,
      "field": "memory",
      "index": null,
      "exactRawTextMatches": true,
      "text": "公園でルミと走り回った午後。"
    },
    {
      "id": "u023",
      "ep": 2,
      "field": "memory",
      "index": null,
      "exactRawTextMatches": true,
      "text": "暗い道で二度の灯を交わす合図を決めた夜。"
    },
    {
      "id": "u029",
      "ep": 2,
      "field": "intro",
      "index": 1,
      "exactRawTextMatches": true,
      "text": "昔、暗い道ではそうして呼び合ったね。"
    },
    {
      "id": "u030",
      "ep": 2,
      "field": "outro",
      "index": 1,
      "exactRawTextMatches": true,
      "text": "どうして、ふたつだったんだろう。"
    },
    {
      "id": "u031",
      "ep": 2,
      "field": "outro",
      "index": 2,
      "exactRawTextMatches": true,
      "text": "今は、ここにいるっていう返事でいいよ。"
    },
    {
      "id": "u032",
      "ep": 2,
      "field": "notebook",
      "index": null,
      "exactRawTextMatches": true,
      "text": "ルミは鐘楼で待っている。小さな火の名前はエン。二度光ったら、ここにいるという返事。"
    },
    {
      "id": "u036",
      "ep": 3,
      "field": "intro",
      "index": 1,
      "exactRawTextMatches": true,
      "text": "帰り道も明るくしとく。ふたりで帰るんだ。"
    },
    {
      "id": "u037",
      "ep": 3,
      "field": "outro",
      "index": 0,
      "exactRawTextMatches": true,
      "text": "帰る道は書いた。忘れても、たどれる。"
    },
    {
      "id": "u038",
      "ep": 3,
      "field": "outro",
      "index": 1,
      "exactRawTextMatches": true,
      "text": "道だけじゃ、思い出せないものもあるよ。"
    },
    {
      "id": "u039",
      "ep": 3,
      "field": "outro",
      "index": 2,
      "exactRawTextMatches": true,
      "text": "それなら、帰ってから教えてくれ。"
    },
    {
      "id": "u040",
      "ep": 3,
      "field": "memory",
      "index": null,
      "exactRawTextMatches": true,
      "text": "夕暮れの街をルミと並んで帰った道。"
    },
    {
      "id": "u041",
      "ep": 3,
      "field": "notebook",
      "index": null,
      "exactRawTextMatches": true,
      "text": "鐘楼のルミを助け、ふたりで帰る。火は記憶を使う。それでも、止まればあの子の灯が消える。"
    },
    {
      "id": "u046",
      "ep": 4,
      "field": "intro",
      "index": 0,
      "exactRawTextMatches": true,
      "text": "ここで泣いた日、何も聞かなかったよね。"
    },
    {
      "id": "u047",
      "ep": 4,
      "field": "intro",
      "index": 1,
      "exactRawTextMatches": true,
      "text": "話せるまで、待つつもりだった。"
    },
    {
      "id": "u048",
      "ep": 4,
      "field": "intro",
      "index": 2,
      "exactRawTextMatches": true,
      "text": "今も、待ってくれる？"
    },
    {
      "id": "u050",
      "ep": 4,
      "field": "outro",
      "index": 0,
      "exactRawTextMatches": true,
      "text": "雨の音しか、思い出せない。"
    },
    {
      "id": "u051",
      "ep": 4,
      "field": "outro",
      "index": 1,
      "exactRawTextMatches": true,
      "text": "隣に座ってくれただけで、よかったんだ。"
    },
    {
      "id": "u052",
      "ep": 4,
      "field": "memory",
      "index": null,
      "exactRawTextMatches": true,
      "text": "雨宿りの軒下で、泣くルミの隣に座った時間。"
    },
    {
      "id": "u055",
      "ep": 5,
      "field": "intro",
      "index": 0,
      "exactRawTextMatches": true,
      "text": "笑わせようとして、灰を顔につけたでしょ。"
    },
    {
      "id": "u056",
      "ep": 5,
      "field": "intro",
      "index": 1,
      "exactRawTextMatches": true,
      "text": "あれは、転んだだけだ。"
    },
    {
      "id": "u057",
      "ep": 5,
      "field": "intro",
      "index": 2,
      "exactRawTextMatches": true,
      "text": "知ってる。だから、余計におかしかった。"
    },
    {
      "id": "u058",
      "ep": 5,
      "field": "outro",
      "index": 0,
      "exactRawTextMatches": true,
      "text": "何がおかしかったのか、もうわからない。"
    },
    {
      "id": "u059",
      "ep": 5,
      "field": "outro",
      "index": 1,
      "exactRawTextMatches": true,
      "text": "笑ったことまで、嘘にはならないよ。"
    },
    {
      "id": "u063",
      "ep": 6,
      "field": "intro",
      "index": 0,
      "exactRawTextMatches": true,
      "text": "壁に、ふたりの影が残ってる。"
    },
    {
      "id": "u064",
      "ep": 6,
      "field": "intro",
      "index": 1,
      "exactRawTextMatches": true,
      "text": "背の低いほうが私。すぐ追いつくって言ったね。"
    },
    {
      "id": "u065",
      "ep": 6,
      "field": "outro",
      "index": 0,
      "exactRawTextMatches": true,
      "text": "俺が会いに行くのは、どんな顔の子だっけ。"
    },
    {
      "id": "u066",
      "ep": 6,
      "field": "outro",
      "index": 1,
      "exactRawTextMatches": true,
      "text": "顔がわからなくても、待ってる人はいるよ。"
    },
    {
      "id": "u067",
      "ep": 6,
      "field": "memory",
      "index": null,
      "exactRawTextMatches": true,
      "text": "ルミの顔と、表情を自分の記憶から思い描く力。"
    },
    {
      "id": "u068",
      "ep": 6,
      "field": "notebook",
      "index": null,
      "exactRawTextMatches": true,
      "text": "ルミ。鐘楼で待つ、大切な人。顔は思い出せない。"
    },
    {
      "id": "u071",
      "ep": 7,
      "field": "intro",
      "index": 0,
      "exactRawTextMatches": true,
      "text": "同じことが、何度も書いてある。"
    },
    {
      "id": "u072",
      "ep": 7,
      "field": "intro",
      "index": 1,
      "exactRawTextMatches": true,
      "text": "鐘楼へ行け。あの子を助けろ。"
    },
    {
      "id": "u073",
      "ep": 7,
      "field": "intro",
      "index": 2,
      "exactRawTextMatches": true,
      "text": "書いたあなたは、今のあなたを信じたんだね。"
    },
    {
      "id": "u074",
      "ep": 7,
      "field": "outro",
      "index": 0,
      "exactRawTextMatches": true,
      "text": "どうして助けたいのか、説明できない。"
    },
    {
      "id": "u075",
      "ep": 7,
      "field": "outro",
      "index": 1,
      "exactRawTextMatches": true,
      "text": "説明できなくても、ここまで来てくれた。"
    },
    {
      "id": "u076",
      "ep": 7,
      "field": "memory",
      "index": null,
      "exactRawTextMatches": true,
      "text": "ルミを迎えに行くと決めた日の、決意に至るいきさつ。"
    },
    {
      "id": "u077",
      "ep": 7,
      "field": "notebook",
      "index": null,
      "exactRawTextMatches": true,
      "text": "鐘楼へ行け。ルミを助けろ。これは俺が、俺に頼んだこと。"
    },
    {
      "id": "u081",
      "ep": 8,
      "field": "intro",
      "index": 0,
      "exactRawTextMatches": true,
      "text": "アッシュ。声が届くうちに、言っておきたい。"
    },
    {
      "id": "u082",
      "ep": 8,
      "field": "intro",
      "index": 1,
      "exactRawTextMatches": true,
      "text": "無理をしてほしかったわけじゃない。"
    },
    {
      "id": "u083",
      "ep": 8,
      "field": "intro",
      "index": 2,
      "exactRawTextMatches": true,
      "text": "迎えに行くって書いたのは、俺だ。"
    },
    {
      "id": "u084",
      "ep": 8,
      "field": "outro",
      "index": 0,
      "exactRawTextMatches": true,
      "text": "アッシュ、聞こえる？"
    },
    {
      "id": "u085",
      "ep": 8,
      "field": "outro",
      "index": 1,
      "exactRawTextMatches": true,
      "text": "聞こえる。……ごめん、君は、誰？"
    },
    {
      "id": "u086",
      "ep": 8,
      "field": "outro",
      "index": 2,
      "exactRawTextMatches": true,
      "text": "あなたを、待っている人。"
    },
    {
      "id": "u087",
      "ep": 8,
      "field": "memory",
      "index": null,
      "exactRawTextMatches": true,
      "text": "呼びかける声を、ルミの声だと感じ取る親しさ。"
    },
    {
      "id": "u088",
      "ep": 8,
      "field": "notebook",
      "index": null,
      "exactRawTextMatches": true,
      "text": "鐘楼へ行け。待っている人を助けろ。声が知らないものになっても、行き先は変わらない。"
    },
    {
      "id": "u091",
      "ep": 9,
      "field": "intro",
      "index": 0,
      "exactRawTextMatches": true,
      "text": "この矢印は、俺の字だ。"
    },
    {
      "id": "u092",
      "ep": 9,
      "field": "intro",
      "index": 2,
      "exactRawTextMatches": true,
      "text": "ここにいる、だったな。ひとりじゃない。"
    },
    {
      "id": "u093",
      "ep": 9,
      "field": "memory",
      "index": null,
      "exactRawTextMatches": true,
      "text": "ルミと過ごした日々が、いつの出来事だったかという連なり。"
    },
    {
      "id": "u094",
      "ep": 9,
      "field": "notebook",
      "index": null,
      "exactRawTextMatches": true,
      "text": "鐘楼へ。待つ人を助けろ。エンと進め。"
    },
    {
      "id": "u115",
      "ep": 9,
      "field": "outro",
      "index": 0,
      "exactRawTextMatches": true,
      "text": "隣にいたのが、いつのことかもわからない。"
    },
    {
      "id": "u116",
      "ep": 9,
      "field": "outro",
      "index": 1,
      "exactRawTextMatches": true,
      "text": "それでも、待たせたままにはできない。"
    },
    {
      "id": "u118",
      "ep": 11,
      "field": "outro",
      "index": 2,
      "exactRawTextMatches": true,
      "text": "朝が来たら、空の色を教えてくれ。"
    },
    {
      "id": "u120",
      "ep": 13,
      "field": "intro",
      "index": 1,
      "exactRawTextMatches": true,
      "text": "覚えようとしなくていい。今は、足元を見て。"
    },
    {
      "id": "u121",
      "ep": 13,
      "field": "intro",
      "index": 2,
      "exactRawTextMatches": true,
      "text": "待っている人がいる。それは、わかる。"
    },
    {
      "id": "u123",
      "ep": 13,
      "field": "notebook",
      "index": null,
      "exactRawTextMatches": true,
      "text": "走れ。"
    }
  ],
  "pass": true,
