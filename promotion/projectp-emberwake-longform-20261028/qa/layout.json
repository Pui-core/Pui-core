      "text": "問い2 / 体験から、面影へ",
      "x": 960,
      "y": 255,
      "width": 296.58203125,
      "height": 24.67041015625,
      "a": 159.36666666666667,
      "b": 167.36666666666667,
      "size": 25
    },
    {
      "name": "Chapter question upper 7",
      "text": "手帳に書けば、",
      "x": 960,
      "y": 80,
      "width": 315.4296875,
      "height": 46.2158203125,
      "a": 323.96666666666664,
      "b": 331.96666666666664,
      "size": 50
    },
    {
      "name": "Chapter question lower 7",
      "text": "忘れずにいられる？",
      "x": 960,
      "y": 165,
      "width": 489.0703125,
      "height": 51.26953125,
      "a": 323.96666666666664,
      "b": 331.96666666666664,
      "size": 56
    },
    {
      "name": "Chapter question context 7",
      "text": "問い3 / 声と、文字の違い",
      "x": 960,
      "y": 255,
      "width": 295.5078125,
      "height": 24.9267578125,
      "a": 323.96666666666664,
      "b": 331.96666666666664,
      "size": 25
    },
    {
      "name": "Chapter question upper 10",
      "text": "約束が薄れても、",
      "x": 960,
      "y": 80,
      "width": 366.7236328125,
      "height": 45.6787109375,
      "a": 488.73333333333335,
      "b": 496.73333333333335,
      "size": 50
    },
    {
      "name": "Chapter question lower 10",
      "text": "なぜ進む？",
      "x": 960,
      "y": 165,
      "width": 265.0703125,
      "height": 51.16015625,
      "a": 488.73333333333335,
      "b": 496.73333333333335,
      "size": 56
    },
    {
      "name": "Chapter question context 10",
