    {
      "id": "u042",
      "episode": 3,
      "sourceField": null,
      "kind": "narration",
      "raw": "道順を書けることと、隣を歩いた時間を思い出せること。会話と手帳を並べると、二つが分かれて見えます。",
      "text": "道順を書けることと、隣を歩いた時間を思い出せること。会話と手帳を並べると、二つが分かれて見えます。",
      "voice": "media/firstcut04-u042.wav",
      "sha256": "ecb4977e147a534ee91713d40a33859cc7dd117560070d4227f2daccc96e0584",
      "duration": 7.221333333333333,
      "start": 32,
      "end": 39.53333333333333,
      "game": "media/ep03-game.mp4",
      "gameAt": 35.900000000000006
