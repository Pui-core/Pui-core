    {
      "id": "u071",
      "episode": 7,
      "sourceField": "intro",
      "kind": "quote",
      "raw": "アッシュ：同じことが、何度も書いてある。",
      "text": "同じことが、何度も書いてある。",
      "voice": "media/firstcut04-u071.wav",
      "sha256": "961280e07b2bf5eac1ec9ff996909a9aff8dabc976261f8d6dea551993155869",
