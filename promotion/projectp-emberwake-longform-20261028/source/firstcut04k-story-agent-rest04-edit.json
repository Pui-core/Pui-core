      "episode": 7,
      "sourceField": "intro",
      "kind": "quote",
      "raw": "アッシュ：鐘楼へ行け。あの子を助けろ。",
      "text": "鐘楼へ行け。あの子を助けろ。",
      "voice": "media/firstcut04-u072.wav",
