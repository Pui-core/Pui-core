    {
      "id": "u036",
      "episode": 3,
      "sourceField": "intro",
      "kind": "quote",
      "raw": "アッシュ：帰り道も明るくしとく。ふたりで帰るんだ。",
      "text": "帰り道も明るくしとく。ふたりで帰るんだ。",
      "voice": "media/firstcut04-u036.wav",
