    {
      "id": "u073",
      "episode": 7,
      "sourceField": "intro",
      "kind": "quote",
      "raw": "ルミ：書いたあなたは、今のあなたを信じたんだね。",
      "text": "書いたあなたは、今のあなたを信じたんだね。",
