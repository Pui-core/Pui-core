    {
      "id": "u076",
      "episode": 7,
      "sourceField": "memory",
      "kind": "quote",
      "raw": "ルミを迎えに行くと決めた日の、決意に至るいきさつ。",
      "text": "ルミを迎えに行くと決めた日の、決意に至るいきさつ。",
