    {
      "id": "u040",
      "episode": 3,
      "sourceField": "memory",
      "kind": "quote",
      "raw": "夕暮れの街をルミと並んで帰った道。",
      "text": "夕暮れの街をルミと並んで帰った道。",
      "voice": "media/firstcut04-u040.wav",
      "sha256": "faa1b7536d70604d34bdd776827744e74658ac304bec9e36bad9157873b45c41",
