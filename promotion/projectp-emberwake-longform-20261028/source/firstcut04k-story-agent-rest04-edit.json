    {
      "id": "u070",
      "episode": 7,
      "sourceField": null,
      "kind": "narration",
      "raw": "顔を思い出せない相手を、それでも助けに行く。理由を確かめようとしたアッシュが見つけるのは、同じ指示の書かれた手帳です。",
      "text": "顔を思い出せない相手を、それでも助けに行く。理由を確かめようとしたアッシュが見つけるのは、同じ指示の書かれた手帳です。",
      "voice": "media/firstcut04-u070.wav",
      "sha256": "0d4d08f2a3103591710941b59ebc343ec4cd5c945242869500238a8008b75c96",
      "duration": 7.850666666666666,
      "start": 39.53333333333333,
      "end": 47.7,
      "game": "media/ep07-game.mp4",
      "gameAt": 17
