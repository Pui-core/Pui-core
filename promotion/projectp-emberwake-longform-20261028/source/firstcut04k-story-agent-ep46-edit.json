      "end": 10.533333333333333,
      "game": "media/ep04-game.mp4",
      "gameAt": 25.1
    },
    {
      "id": "u051",
      "episode": 4,
      "sourceField": "outro",
      "kind": "quote",
      "raw": "ルミ：隣に座ってくれただけで、よかったんだ。",
      "text": "隣に座ってくれただけで、よかったんだ。",
      "voice": "media/firstcut04-u051.wav",
      "sha256": "a0e2d0f5ca170ba2e650ff7fe251b2785ffa1f17ca2f17ae173e151c560bdaad",
      "duration": 2.8586666666666667,
      "start": 10.533333333333333,
      "end": 13.7,
      "game": "media/ep04-game.mp4",
      "gameAt": 27.8
    },
    {
      "id": "u052",
      "episode": 4,
      "sourceField": "memory",
      "kind": "quote",
      "raw": "雨宿りの軒下で、泣くルミの隣に座った時間。",
      "text": "雨宿りの軒下で、泣くルミの隣に座った時間。",
      "voice": "media/firstcut04-u052.wav",
      "sha256": "d24cdc44bdde5dc0b864dc6d8e27b7eb5db0258f157e824d3c779441d4ba3663",
      "duration": 3.68,
      "start": 13.7,
      "end": 17.7,
      "game": "media/ep04-game.mp4",
      "gameAt": 30.5
    },
    {
      "id": "u055",
      "episode": 5,
      "sourceField": "intro",
      "kind": "quote",
      "raw": "ルミ：笑わせようとして、灰を顔につけたでしょ。",
      "text": "笑わせようとして、灰を顔につけたでしょ。",
      "voice": "media/firstcut04-u055.wav",
      "sha256": "5e67c9058600a213d2d5f1de6ced96899e46832ffe910f1e35e45f4c1dc2936a",
      "duration": 2.8906666666666667,
      "start": 17.7,
      "end": 20.9,
      "game": "media/ep05-game.mp4",
      "gameAt": 33.2
    },
    {
      "id": "u056",
      "episode": 5,
      "sourceField": "intro",
      "kind": "quote",
      "raw": "アッシュ：あれは、転んだだけだ。",
      "text": "あれは、転んだだけだ。",
      "voice": "media/firstcut04-u056.wav",
      "sha256": "3f509c67c1f00c434ae0694ace1fb9148efd8b98f8df9e0520b9cdd1438d5d90",
      "duration": 1.7493333333333334,
      "start": 20.9,
      "end": 22.966666666666665,
      "game": "media/ep05-game.mp4",
      "gameAt": 35.900000000000006
    },
    {
      "id": "u057",
      "episode": 5,
      "sourceField": "intro",
      "kind": "quote",
      "raw": "ルミ：知ってる。だから、余計におかしかった。",
      "text": "知ってる。だから、余計におかしかった。",
      "voice": "media/firstcut04-u057.wav",
      "sha256": "60fb34dcde745781d54385ed0cf175b8075b920363ad7e73df6b29ec60eaef16",
      "duration": 3.3493333333333335,
      "start": 22.966666666666665,
      "end": 26.633333333333333,
      "game": "media/ep05-game.mp4",
      "gameAt": 17
    },
    {
      "id": "u058",
      "episode": 5,
      "sourceField": "outro",
      "kind": "quote",
      "raw": "アッシュ：何がおかしかったのか、もうわからない。",
      "text": "何がおかしかったのか、もうわからない。",
      "voice": "media/firstcut04-u058.wav",
      "sha256": "5abfad1f0fe8d86de2660e1663f2d3a8d6a83dcc0ed0e280cfea924e2acb81cf",
      "duration": 2.6666666666666665,
      "start": 26.633333333333333,
      "end": 29.6,
      "game": "media/ep05-game.mp4",
      "gameAt": 19.7
    },
    {
      "id": "u059",
      "episode": 5,
      "sourceField": "outro",
      "kind": "quote",
      "raw": "ルミ：笑ったことまで、嘘にはならないよ。",
      "text": "笑ったことまで、嘘にはならないよ。",
      "voice": "media/firstcut04-u059.wav",
      "sha256": "25cb655d77cd00b9b2bb5889bbd358673af8de606663a43307db6d42031d8dc2",
      "duration": 2.538666666666667,
      "start": 29.6,
      "end": 32.46666666666667,
      "game": "media/ep05-game.mp4",
      "gameAt": 22.4
    },
    {
      "id": "u062",
      "episode": 6,
      "sourceField": "editorial",
      "kind": "narration",
      "raw": "出来事や、その時の時間を忘れるだけなら、顔を見れば思い出せるのでしょうか。次に遠ざかるのは、面影です。",
      "text": "出来事や、その時の時間を忘れるだけなら、顔を見れば思い出せるのでしょうか。次に遠ざかるのは、面影です。",
      "voice": "media/firstcut04-u062.wav",
      "sha256": "b532d1107bb1217355227984dbfc523d696205e57c4ef3c0687397901eb2aedc",
      "duration": 7.594666666666667,
      "start": 32.46666666666667,
