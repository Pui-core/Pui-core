    {
      "id": "u046",
      "episode": 4,
      "sourceField": "intro",
      "kind": "quote",
      "raw": "ルミ：ここで泣いた日、何も聞かなかったよね。",
      "text": "ここで泣いた日、何も聞かなかったよね。",
      "voice": "media/firstcut04-u046.wav",
      "sha256": "47960b57f45f95aa6350809fd8510d474e73bda821425c9de0ede56fd0dc3f75",
