      "gameAt": 17
    },
    {
      "id": "u047",
      "episode": 4,
      "sourceField": "intro",
      "kind": "quote",
      "raw": "アッシュ：話せるまで、待つつもりだった。",
      "text": "話せるまで、待つつもりだった。",
      "voice": "media/firstcut04-u047.wav",
      "sha256": "ac88031d5fb3e0ff347356c5adbb7b771ac41cd3611af29e345b12e80f0aa973",
