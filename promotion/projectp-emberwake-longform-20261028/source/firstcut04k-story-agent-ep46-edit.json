      "game": "media/ep04-game.mp4",
      "gameAt": 22.4
    },
    {
      "id": "u050",
      "episode": 4,
      "sourceField": "outro",
      "kind": "quote",
      "raw": "アッシュ：雨の音しか、思い出せない。",
      "text": "雨の音しか、思い出せない。",
      "voice": "media/firstcut04-u050.wav",
      "sha256": "32f46100df0b9e36d13b8a32847bb5eab0516317f6a3f36e9a9e24e9e90d1f3d",
      "duration": 2.1653333333333333,
