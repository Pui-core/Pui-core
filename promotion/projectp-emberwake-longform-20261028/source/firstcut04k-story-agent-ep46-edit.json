    {
      "id": "u068",
      "episode": 6,
      "sourceField": "notebook",
      "kind": "quote",
      "raw": "ルミ。鐘楼で待つ、大切な人。顔は思い出せない。",
      "text": "ルミ。鐘楼で待つ、大切な人。顔は思い出せない。",
