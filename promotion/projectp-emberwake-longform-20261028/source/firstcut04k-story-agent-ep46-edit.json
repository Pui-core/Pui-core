      "gameAt": 35.900000000000006
    },
    {
      "id": "u067",
      "episode": 6,
      "sourceField": "memory",
      "kind": "quote",
      "raw": "ルミの顔と、表情を自分の記憶から思い描く力。",
      "text": "ルミの顔と、表情を自分の記憶から思い描く力。",
      "voice": "media/firstcut04-u067.wav",
      "sha256": "649a595e94733d3557657b43cf3c356d396bb75c57ef6cd86a4b653fa32e09de",
