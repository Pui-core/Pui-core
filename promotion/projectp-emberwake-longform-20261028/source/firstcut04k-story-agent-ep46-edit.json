    {
      "id": "u048",
      "episode": 4,
      "sourceField": "intro",
      "kind": "quote",
      "raw": "ルミ：今も、待ってくれる？",
      "text": "今も、待ってくれる？",
      "voice": "media/firstcut04-u048.wav",
      "sha256": "66ad5d6f98f20cc10485f1de64f3aa5fb1b12bac8b4b1e989b5f91826f01090a",
      "duration": 2.005333333333333,
