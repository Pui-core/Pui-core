  "voices": [
    {
      "id": "normal",
      "text": "同じ場所へ行く道は、ひとつではありません。まずは、通常の足場。",
      "at": 0.1,
      "windowEnd": 7.3,
      "quote": false,
      "reuseFrom": {
        "spec": "source/emberwake-jetcut03b-comparison-measured.json",
        "id": "normal"
      }
    },
    {
      "id": "branch",
      "text": "ダッシュなら、上の二段へ。この枝も、同じ足場へ合流します。",
      "at": 7.6,
      "windowEnd": 13.4,
      "quote": false,
      "reuseFrom": {
        "spec": "source/emberwake-jetcut03b-comparison-measured.json",
        "id": "branch"
      }
    },
    {
      "id": "cost",
      "text": "近道を選べても、失う記憶まで選び直せるわけではありません。",
      "at": 14,
      "windowEnd": 20.8,
      "quote": false,
      "reuseFrom": {
        "spec": "source/emberwake-jetcut03b-comparison-measured.json",
        "id": "cost"
      }
    },
    {
      "id": "test",
      "text": "では、落ちたときは？　同じ場所で、押す長さを変えて確かめます。",
      "at": 18.8,
      "windowEnd": 26.8,
      "quote": false,
      "reuseFrom": {
        "spec": "source/emberwake-jetcut03b-comparison-measured.json",
        "id": "test"
      }
    },
    {
      "id": "short",
      "text": "短押しでは届かず、出発地点へ。",
      "at": 24.1,
      "windowEnd": 30.8,
      "quote": false,
      "reuseFrom": {
        "spec": "source/emberwake-jetcut03b-comparison-measured.json",
        "id": "short"
      }
    },
    {
      "id": "held",
      "text": "今度は長く。上の足場に、着地できました。",
      "at": 31,
      "windowEnd": 36.8,
      "quote": false,
      "reuseFrom": {
        "spec": "source/emberwake-jetcut03b-comparison-measured.json",
        "id": "held"
      }
    },
    {
      "id": "counter",
      "text": "再挑戦しても、記憶は一つのまま。同じ話では、さらに失いません。",
      "at": 37,
      "windowEnd": 44.3,
      "quote": false,
      "reuseFrom": {
        "spec": "source/emberwake-jetcut03b-comparison-measured.json",
        "id": "counter"
      }
    },
    {
      "id": "advance",
      "text": "怖いのは、その先へ進むこと。新しい話を終えると、またひとつ失います。",
      "at": 44.5,
      "windowEnd": 51.8,
      "quote": false,
      "reuseFrom": {
        "spec": "source/emberwake-jetcut03b-comparison-measured.json",
        "id": "advance"
      }
    },
    {
      "id": "ash-route",
      "text": "帰る道は書いた。忘れても、たどれる。",
