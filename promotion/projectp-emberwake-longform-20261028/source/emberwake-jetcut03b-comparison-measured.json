    },
    {
      "id": "counter",
      "text": "再挑戦しても、記憶は一つのまま。同じ話では、さらに失いません。",
      "at": 37,
      "windowEnd": 44.3,
      "quote": false,
      "reuseFrom": {
        "spec": "source/emberwake-jetcut03-comparison-measured.json",
