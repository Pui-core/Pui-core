      "end": 5.124,
      "sha256": "a2edb4397a38c1cb34c317bb435b6b7cf74d363cceff3ddddaf19cb46770a440"
    },
    {
      "id": "branch",
      "text": "ダッシュなら、上の二段へ。この枝も、同じ足場へ合流します。",
      "at": 7.6,
      "windowEnd": 13.4,
      "quote": false,
      "reuseFrom": {
        "spec": "source/emberwake-jetcut03-comparison-measured.json",
        "id": "branch"
      },
      "file": "emberwake-jetcut03-comparison-voice-002.wav",
      "duration": 4.736,
      "end": 12.335999999999999,
      "sha256": "cf17ce739e7f54285cb2eaf175db7375c2159b96f741d4f82432cad1263f57b4"
    },
    {
      "id": "cost",
      "text": "近道を選べても、失う記憶まで選び直せるわけではありません。",
      "at": 14,
      "windowEnd": 20.8,
      "quote": false,
      "reuseFrom": {
        "spec": "source/emberwake-jetcut03-comparison-measured.json",
        "id": "cost"
      },
      "file": "emberwake-jetcut03-comparison-voice-003.wav",
