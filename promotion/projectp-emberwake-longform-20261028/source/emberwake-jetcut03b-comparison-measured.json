    },
    {
      "id": "held",
      "text": "今度は長く。上の足場に、着地できました。",
      "at": 31,
      "windowEnd": 36.8,
      "quote": false,
      "reuseFrom": {
        "spec": "source/emberwake-jetcut03-comparison-measured.json",
        "id": "held"
