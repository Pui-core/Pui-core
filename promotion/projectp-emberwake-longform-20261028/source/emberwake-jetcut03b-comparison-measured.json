    },
    {
      "id": "advance",
      "text": "怖いのは、その先へ進むこと。新しい話を終えると、またひとつ失います。",
      "at": 44.5,
      "windowEnd": 51.8,
      "quote": false,
      "reuseFrom": {
        "spec": "source/emberwake-jetcut03-comparison-measured.json",
