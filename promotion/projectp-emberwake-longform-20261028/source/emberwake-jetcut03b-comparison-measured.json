      "end": 18.34133333333333,
      "sha256": "8ce424f10ecde479821c6438b90f3e15e8c3368a0ba39c5d697fee27155fc35a"
    },
    {
      "id": "test",
      "text": "では、落ちたときは？　同じ場所で、押す長さを変えて確かめます。",
      "at": 18.8,
      "windowEnd": 26.8,
      "quote": false,
      "reuseFrom": {
        "spec": "source/emberwake-jetcut03-comparison-measured.json",
        "id": "test"
      },
      "file": "emberwake-jetcut03-comparison-voice-004.wav",
      "duration": 4.96,
      "end": 23.76,
      "sha256": "337fef2521a0ba5634576cd9f9a402ef15a4ba9549803db815a49bbbf395db51"
    },
    {
      "id": "short",
      "text": "短押しでは届かず、出発地点へ。",
      "at": 24.1,
      "windowEnd": 30.8,
      "quote": false,
      "reuseFrom": {
        "spec": "source/emberwake-jetcut03-comparison-measured.json",
        "id": "short"
