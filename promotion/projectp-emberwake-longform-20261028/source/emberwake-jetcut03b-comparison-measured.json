  "voices": [
    {
      "id": "normal",
      "text": "同じ場所へ行く道は、ひとつではありません。まずは、通常の足場。",
      "at": 0.1,
      "windowEnd": 7.3,
      "quote": false,
      "reuseFrom": {
        "spec": "source/emberwake-jetcut03-comparison-measured.json",
        "id": "normal"
